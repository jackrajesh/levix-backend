# ─────────────────────────────────────────────
# Levix Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/levix_db

# === AUTH / JWT ===
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === EMAIL — Resend (https://resend.com) ===
# Required for the contact form to send real emails.
# Get your API key from https://resend.com/api-keys
# The contact form sends to levixsupport@gmail.com using this key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# === WHATSAPP / META ===
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# === GOOGLE ANALYTICS ===
# GA4 Measurement ID (already embedded in index.html)
GA_MEASUREMENT_ID=G-MC7H8XFN47

# === AI (OPTIONAL) ===
GOOGLE_API_KEY=

# === CORS ===
# Comma-separated allowed origins. Use * to allow all (development only).
ALLOWED_ORIGINS=https://levixapp.in

# === SERVER ===
PORT=8000
